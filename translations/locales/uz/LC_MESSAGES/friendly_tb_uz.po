"\n"

#: ft_gettext.py:90
msgid "Friendly-traceback does not know the cause of this error.\n"
msgstr "Friendly-traceback bu xatoning sababini bilmaydi.\n"

#: ft_gettext.py:96
msgid "No information is known about this exception.\n"
msgstr "Bu istisno haqida heç qanday maʼlumot yöq.\n"

#: ft_gettext.py:98

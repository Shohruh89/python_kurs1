msgid "pages.CreatingKeyValuePairs.steps.swap_keys_values_exercise.hints.1.text"
msgstr "Yangi luğat yaratib, uni kiritilgan luğatga bağliq kalit-qiymat juftlari bilan töldirişingiz kerak."


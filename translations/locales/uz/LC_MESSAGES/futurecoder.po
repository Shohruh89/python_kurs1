msgid "pages.TheFullTicTacToeGame.steps.the_full_game.hints.24.text"
msgstr "Ğolibni sikl içida tekşirişingiz kerak, çunki öyinçi qaçon yutişini bilmaysiz."

msgid "pages.TheFullTicTacToeGame.steps.the_full_game.hints.25.text"
msgstr "`print_winner` ni çaqirganingizdan keyin funksiyani tugatiş uçun `return` dan foydalanişingiz mumkin."

msgid "pages.TheFullTicTacToeGame.steps.the_full_game.hints.26.text"
msgstr "Şunçaki yolğiz `return` yetarli, `play_game` qiymat qaytariş uçun möljallanmagan."

msgid "pages.TheFullTicTacToeGame.steps.the_full_game.hints.27.text"
